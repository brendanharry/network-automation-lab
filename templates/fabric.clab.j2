---
# Generated by Ansible; edit inventory or templates/fabric.clab.j2.
name: fabric

topology:
  nodes:
{% for node in groups['leafs'] + groups['spines'] %}
    {{ node }}:
      kind: linux
      image: quay.io/frrouting/frr:10.7.0
      binds:
        - ../configs/{{ node }}.cfg:/etc/frr/frr.conf
        - frr/daemons:/etc/frr/daemons
        - frr/vtysh.conf:/etc/frr/vtysh.conf

{% endfor %}
{% for node in groups['test_hosts'] %}
    {{ node }}:
      kind: linux
      image: {{ host_image }}
      cmd: sleep infinity

{% endfor %}
  links:
{% for leaf in groups['leafs'] %}
{% for link in hostvars[leaf].underlay_interfaces %}
{% set peer_link = hostvars[link.peer].underlay_interfaces
   | selectattr('peer', 'equalto', leaf) | first %}
    - endpoints: ["{{ leaf }}:{{ link.name }}", "{{ link.peer }}:{{ peer_link.name }}"]
{% endfor %}
{% endfor %}
{% for node in groups['test_hosts'] %}
{% set port = hostvars[node].attachment %}
    - endpoints: ["{{ port.leaf }}:{{ port.leaf_interface }}", "{{ node }}:{{ port.interface }}"]
{% endfor %}
