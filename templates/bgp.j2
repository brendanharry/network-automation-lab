! Generated by Ansible
! Device: {{ inventory_hostname }}
! Role: {{ role }}

hostname {{ inventory_hostname }}

interface lo
 ip address {{ loopback_ip }}/32

{% for interface in underlay_interfaces | default([]) %}
interface {{ interface.name }}
 description Link to {{ interface.peer }}
 ip address {{ interface.ip }}
{% endfor %}

router bgp {{ asn }}
 bgp router-id {{ loopback_ip }}
 no bgp ebgp-requires-policy
 network {{ loopback_ip }}/32
{% for interface in underlay_interfaces | default([]) %}
 neighbor {{ interface.peer_ip }} remote-as {{ hostvars[interface.peer].asn }}
{% endfor %}
 address-family l2vpn evpn
{% for interface in underlay_interfaces %}
  neighbor {{ interface.peer_ip }} activate
{% if role == 'spine' %}
  neighbor {{ interface.peer_ip }} attribute-unchanged next-hop
{% endif %}
{% endfor %}
{% if role == 'leaf' %}
  advertise-all-vni
  vni {{ tenant.vni }}
   route-target import {{ overlay_route_target }}
   route-target export {{ overlay_route_target }}
  exit-vni
{% endif %}
 exit-address-family
