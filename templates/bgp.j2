! Generated by Ansible
! Device: {{ inventory_hostname }}
! Role: {{ role }}

hostname {{ inventory_hostname }}

interface lo
 ip address {{ loopback_ip }}/32

{% for interface in underlay_interfaces | default([]) %}
interface {{ interface.name }}
 description Link to {{ interface.peer }}
 ip address {{ interface.ip }}
{% endfor %}

{% if role == 'leaf' %}
vrf {{ tenant.name }}
 vni {{ tenant.l3_vni }}
exit-vrf
{% endif %}
router bgp {{ asn }}
 bgp router-id {{ loopback_ip }}
 no bgp ebgp-requires-policy
 network {{ loopback_ip }}/32
{% for interface in underlay_interfaces | default([]) %}
 neighbor {{ interface.peer_ip }} remote-as {{ hostvars[interface.peer].asn }}
{% endfor %}
 address-family l2vpn evpn
{% for interface in underlay_interfaces %}
  neighbor {{ interface.peer_ip }} activate
{% if role == 'spine' %}
  neighbor {{ interface.peer_ip }} attribute-unchanged next-hop
{% endif %}
{% endfor %}
{% if role == 'leaf' %}
  advertise-all-vni
{% for segment in segments if inventory_hostname in segment.leaves %}
  vni {{ segment.vni }}
   route-target import {{ evpn_rt_admin }}:{{ segment.vni }}
   route-target export {{ evpn_rt_admin }}:{{ segment.vni }}
  exit-vni
{% endfor %}
{% endif %}
 exit-address-family
{% if role == 'leaf' %}
exit

router bgp {{ asn }} vrf {{ tenant.name }}
 bgp router-id {{ loopback_ip }}
 no bgp ebgp-requires-policy
 address-family ipv4 unicast
{% for segment in segments if inventory_hostname in segment.leaves %}
  network {{ segment.subnet }}
{% endfor %}
 exit-address-family
 address-family l2vpn evpn
  route-target import {{ l3_route_target }}
  route-target export {{ l3_route_target }}
  advertise ipv4 unicast
 exit-address-family
{% endif %}
